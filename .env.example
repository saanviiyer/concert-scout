# Copy to .env and fill in what you have. Everything is optional —
# the app runs in demo mode (synthetic events) with no keys at all.

# --- Event providers (official public APIs, no scraping) ---
# https://developer.ticketmaster.com/ -> Discovery API key
TICKETMASTER_API_KEY=

# https://seatgeek.com/account/develop -> client ID
SEATGEEK_CLIENT_ID=

# --- Music taste ---
# https://developer.spotify.com/dashboard -> create an app,
# add redirect URI: http://127.0.0.1:8000/callback
SPOTIFY_CLIENT_ID=

# YouTube Music has no official API. If you want library import,
# `pip install ytmusicapi`, run `ytmusicapi browser` to create browser.json,
# and set the path here:
YTMUSIC_AUTH_FILE=
